PORT=4000
DATABASE_URL=postgresql://hotelverify:hotelverify@localhost:5432/hotelverify_app
REDIS_URL=redis://localhost:6379

# Symmetric secrets for app-session JWTs (access/refresh). Unrelated to the
# issuer's Ed25519 credential-signing key from Milestone 3 onward.
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me

# For proxying PLATFORM_ADMIN-only issuer routes (/review, /admin/revoke) —
# see api/src/routes/issuerReview.js. Must match issuer's ISSUER_SERVICE_TOKEN.
ISSUER_BASE_URL=http://localhost:4001
ISSUER_SERVICE_TOKEN=dev_issuer_service_token_change_me
