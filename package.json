{
  "name": "hotelverify",
  "private": true,
  "version": "0.1.0",
  "description": "Guest-identity platform: verify once, check in anywhere, the hotel never stores your ID.",
  "workspaces": [
    "packages/credentials",
    "issuer",
    "api",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "seed": "node scripts/seed.js",
    "demo": "node scripts/demo.js",
    "demo:live": "node scripts/demo.js --live",
    "make-fake-ids": "node scripts/make-fake-ids.js",
    "face-far-frr-sweep": "node scripts/face-far-frr-sweep.js",
    "purge-retention": "node scripts/purge-retention.js",
    "migrate:issuer": "npm run migrate --workspace=issuer",
    "migrate:api": "npm run migrate --workspace=api",
    "migrate": "npm run migrate:issuer && npm run migrate:api",
    "dev:issuer": "npm run dev --workspace=issuer",
    "dev:api": "npm run dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "test": "npm run test --workspace=credentials && npm run test --workspace=issuer && npm run test --workspace=api",
    "test:credentials": "npm run test --workspace=credentials",
    "test:credentials:coverage": "npm run test:coverage --workspace=credentials",
    "test:issuer": "npm run test --workspace=issuer",
    "test:api": "npm run test --workspace=api",
    "lint": "eslint ."
  },
  "dependencies": {
    "argon2": "^0.31.2",
    "dotenv": "^16.4.5",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "eslint": "^9.9.0",
    "globals": "^15.9.0"
  },
  "allowScripts": {
    "argon2@0.31.2": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true,
    "sharp@0.33.5": true,
    "tesseract.js@5.1.1": true,
    "core-js@3.29.1": true,
    "canvas@3.2.3": true
  }
}
