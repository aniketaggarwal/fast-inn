PORT=4001
DATABASE_URL=postgresql://hotelverify:hotelverify@localhost:5432/hotelverify_issuer

# S3_ENDPOINT is what this service itself talks to. S3_PUBLIC_ENDPOINT is
# baked into presigned URLs, which the guest's own browser follows — it
# must be reachable from the host, not an internal docker hostname.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=hotelverify
S3_SECRET_KEY=hotelverify_dev_only
S3_BUCKET=hotelverify-kyc
S3_REGION=us-east-1

ISSUER_IDENTIFIER=https://issuer.hotelverify.test

# Shared secret api's proxy attaches to staff-only issuer routes
# (/review, /admin/revoke) after checking the caller is a logged-in
# PLATFORM_ADMIN. Never sent to or known by the browser directly.
ISSUER_SERVICE_TOKEN=dev_issuer_service_token_change_me
