# ─────────────────────────────────────────
#  HotelVerify Backend — Environment Config
# ─────────────────────────────────────────
# Copy this file to .env and fill in values
# cp .env.example .env

# ── Server ──────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database (PostgreSQL) ────────────────
DATABASE_URL=postgresql://hotelverify:password@localhost:5432/hotelverify_db
# OR provide individual fields:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hotelverify_db
DB_USER=hotelverify
DB_PASSWORD=password

# ── Redis ────────────────────────────────
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=   # uncomment if Redis has auth

# ── JWT ──────────────────────────────────
JWT_SECRET=change_this_to_a_very_long_random_secret_string_min_64_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── File Storage (MVP: local disk) ───────
STORAGE_TYPE=local           # 'local' | 's3'
UPLOADS_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ── AWS S3 (production) ──────────────────
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=hotelverify-docs

# ── OTP ──────────────────────────────────
OTP_EXPIRES_SECONDS=300      # 5 minutes
OTP_LENGTH=6
# TWILIO_ACCOUNT_SID=        # uncomment for production SMS
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1234567890

# ── Email (Nodemailer) ───────────────────
EMAIL_FROM=noreply@hotelverify.in
# Leave SMTP fields blank in dev → auto-uses Ethereal test account
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Frontend URL (CORS) ──────────────────
FRONTEND_URL=http://localhost:5173

# ── Rate Limiting ────────────────────────
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX=100
